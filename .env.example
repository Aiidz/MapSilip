# Copy to .env.local and replace these placeholders with values from your Supabase project.
# Only after project authorization. No credentials are needed for the UI preview.
# HTTPS origin and a current sb_publishable_ key are required by the factories.
# Never use a secret/service-role or legacy JWT key in these public variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only. Required to create tenant Auth identities without a signup
# confirmation email. Keep this out of NEXT_PUBLIC_ variables and logs.
SUPABASE_SERVICE_ROLE_KEY=

# Required only for the staff-auth server endpoints after the reviewed hosted
# authorization foundation is explicitly approved and installed. Never use a
# service-role key here. The URL must authenticate as mapsilip_security_executor
# through the Supabase transaction pooler with TLS verification.
MAPSILIP_SECURITY_DATABASE_URL=

# Generate a random server-only value of at least 32 bytes. Used only to HMAC
# rate-limit identifiers and client IPs; do not reuse the database password.
MAPSILIP_RATE_LIMIT_HASH_KEY=

# Exact public app origin used for same-origin mutation checks.
MAPSILIP_APP_ORIGIN=http://localhost:3000

# Staging switch only. Keep false until the reviewed hosted security gate passes.
MAPSILIP_STAFF_AUTH_ENABLED=false

# Local testing only. Protected tenant pages and Auth routes stay closed unless enabled.
MAPSILIP_TENANT_AUTH_ENABLED=false

# Password recovery email is delivered by Supabase Auth. Configure its Site URL,
# redirect allowlist, Reset Password template, and email delivery in Supabase.
# Account requests and decisions use in-app notifications; no app email API key
# or custom delivery worker is required.

# Optional Web Push. Keep disabled until separate provisioning/device-test approval.
# Installation works independently of this flag. Never use NEXT_PUBLIC_ for private keys.
MAPSILIP_PUSH_ENABLED=false
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
MAPSILIP_PUSH_WORKER_SECRET=
