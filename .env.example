# Copy to .env.local and replace these placeholders with values from your Supabase project.
# Only after project authorization. No credentials are needed for the UI preview.
# HTTPS origin and a current sb_publishable_ key are required by the factories.
# Never use a secret/service-role or legacy JWT key in these public variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only. Required to create tenant Auth identities without a signup
# confirmation email. Keep this out of NEXT_PUBLIC_ variables and logs.
SUPABASE_SERVICE_ROLE_KEY=

# Required only for the staff-auth server endpoints after the reviewed hosted
# authorization foundation is explicitly approved and installed. Never use a
# service-role key here. The URL must authenticate as mapsilip_security_executor
# through the Supabase transaction pooler with TLS verification.
MAPSILIP_SECURITY_DATABASE_URL=

# Generate a random server-only value of at least 32 bytes. Used only to HMAC
# rate-limit identifiers and client IPs; do not reuse the database password.
MAPSILIP_RATE_LIMIT_HASH_KEY=

# Exact public app origin used for same-origin mutation checks.
MAPSILIP_APP_ORIGIN=http://localhost:3000

# Staging switch only. Keep false until the reviewed hosted security gate passes.
MAPSILIP_STAFF_AUTH_ENABLED=false

# Local testing only. Protected tenant pages and Auth routes stay closed unless enabled.
MAPSILIP_TENANT_AUTH_ENABLED=false

# Password recovery email is delivered by Supabase Auth. Configure its Site URL,
# redirect allowlist, Reset Password template, and email delivery in Supabase.
# Account requests and decisions use in-app notifications; no app email API key
# or custom delivery worker is required.

# Optional Web Push. Keep disabled until separate provisioning/device-test approval.
# Installation works independently of this flag. Never use NEXT_PUBLIC_ for private keys.
MAPSILIP_PUSH_ENABLED=false
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
MAPSILIP_PUSH_WORKER_SECRET=

# Storage archives: apply/review the forward-only migration and provision the
# matching private DB receipt key before enabling. Never use NEXT_PUBLIC_.
STORAGE_MANAGEMENT_ENABLED=false
STORAGE_RECEIPT_SECRET=
# Separate owner-authorized activation; every individual removal still needs confirmation.
STORAGE_CLEANUP_ENABLED=false

# Owner Google Drive consent for Backup Management. Use a fixed HTTPS callback
# on MAPSILIP_APP_ORIGIN. The registry URL must use a dedicated server DB identity.
BACKUP_REGISTRY_DATABASE_URL=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
# Google Cloud KMS resource name (projects/.../locations/.../keyRings/.../cryptoKeys/...).
# The app runtime uses Vercel workload identity federation to access this key.
BACKUP_TOKEN_KEY_ID=
# Vercel OIDC -> Google STS -> dedicated KMS service account impersonation.
BACKUP_GCP_WIF_AUDIENCE=
BACKUP_GCP_SERVICE_ACCOUNT=
# Enable only after the durable runner and both destinations have been verified.
BACKUP_WORKER_ENABLED=false
CRON_SECRET=

# Isolated backup worker only. Mount key and alias files with restricted permissions.
BACKUP_WORKER_REGISTRY_URL=
BACKUP_SOURCE_DATABASE_URL=
BACKUP_ENCRYPTED_STAGING_ROOT=
BACKUP_STAGING_OWNER_ID=
BACKUP_TENANT_ALIAS_FILE=
BACKUP_SIGNING_KEY_FILE=
BACKUP_VERIFICATION_KEY_FILE=
BACKUP_SOURCE_COMMIT=
BACKUP_DRIVE_ROOT_ID=
BACKUP_SOURCE_STORAGE_TOKEN=
# Public PEM of the independent receiver. Keep its private key on the receiving device.
BACKUP_RECEIVER_PUBLIC_KEY=

# Set to gcloud-adc on a local worker. Leave unset on Google Cloud.
BACKUP_WORKER_GOOGLE_AUTH=

# No-billing mode. Set BACKUP_TOKEN_KEY_ID=local-v1 in both runtimes and
# supply the same securely generated 32-byte hex key in both secret stores.
BACKUP_LOCAL_WRAPPING_KEY=

# Dedicated Storage Auth reader. Set these instead of a static Storage token.
BACKUP_SOURCE_STORAGE_EMAIL=
BACKUP_SOURCE_STORAGE_PASSWORD=
BACKUP_SOURCE_STORAGE_SUBJECT=
